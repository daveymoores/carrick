{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*"]
}
